{
  "name": "lokbest-mobile-automation",
  "version": "1.0.0",
  "description": "Mobile automation framework for Lokbest Android App using WebdriverIO and Appium",
  "main": "index.js",
  "scripts": {
    "test": "wdio run ./config/wdio.android.conf.js",
    "test:android": "wdio run ./config/wdio.android.conf.js",
    "test:onboarding": "wdio run ./config/wdio.android.conf.js --spec test/specs/onboarding/**/*.js",
    "test:auth": "wdio run ./config/wdio.android.conf.js --spec test/specs/authentication/**/*.js",
    "test:booking": "wdio run ./config/wdio.android.conf.js --spec test/specs/booking/**/*.js",
    "test:store": "wdio run ./config/wdio.android.conf.js --spec test/specs/store/**/*.js",
    "test:age-verification": "wdio run ./config/wdio.android.conf.js --spec test/specs/age-verification/**/*.js",
    "test:localization": "wdio run ./config/wdio.android.conf.js --spec test/specs/localization/**/*.js",
    "test:english": "wdio run ./config/wdio.android.conf.js --spec test/specs/localization/english-text.spec.js",
    "test:deutsch": "wdio run ./config/wdio.android.conf.js --spec test/specs/localization/deutsch-text.spec.js",
    "test:italian": "wdio run ./config/wdio.android.conf.js --spec test/specs/localization/italian-text.spec.js",
    "wdio": "wdio run ./config/wdio.android.conf.js"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "android",
    "mobile-automation",
    "lokbest",
    "page-object-model"
  ],
  "author": "Lokbest QA Team",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@wdio/cli": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "dotenv": "^16.4.7"
  }
}
